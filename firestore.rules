rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- COMMANDES ----------
    match /orders/{orderId} {
      allow create: if true;
      allow get: if true;
      allow list: if request.auth != null;
      allow update: if request.auth != null
        || (
             request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'updatedAt', 'stockRestored'])
             && request.resource.data.status == 'cancelled'
           );
      allow delete: if request.auth != null;
    }

    // ---------- MENU (categories) ----------
    match /menu/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ---------- ITEMS DU MENU / STOCKS ----------
    match /menuItems/{itemId} {
      allow read: if true;
      allow create, delete: if request.auth != null;
      allow update: if request.auth != null
        || (
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
             && request.resource.data.stock is number
             && request.resource.data.stock >= 0
           );
    }

    // ---------- PARAMETRES ----------
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ---------- AVIS CLIENTS ----------
    match /reviews/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // ---------- POURBOIRES ----------
    match /tips/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // ---------- INGREDIENTS & COUTS ----------
    match /ingredients/{id} {
      allow read, write: if request.auth != null;
    }

    // ---------- TEMOIGNAGES (page d'avis publique) ----------
    match /testimonials/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // ---------- AVIS VALIDES (affiches sur le site) ----------
    match /publicTestimonials/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ---------- PRECOMMANDES (formulaire famille) ----------
    // Chacun cree sa precommande. Il peut la corriger tant qu'il a son
    // identifiant (garde sur son telephone) : cela evite les doublons.
    // Les convives voient la liste des prenoms sur le site pour retrouver
    // leur choix en un clic : la lecture est donc publique.
    match /preorders/{id} {
      allow create: if true;
      allow read: if true;
      allow update: if request.auth != null
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'items', 'total', 'amount', 'note', 'service',
                       'claimed', 'orderId', 'updatedAt']);
      allow delete: if request.auth != null;
    }

    // ---------- COURSES / ACHATS (admin) ----------
    match /purchases/{id} {
      allow read, write: if request.auth != null;
    }

    // ---------- CORBEILLE (suppressions recuperables, admin) ----------
    match /trash/{id} {
      allow read, write: if request.auth != null;
    }

    // ---------- Tout le reste : interdit ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
